POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ecommerce_dw
POSTGRES_PORT=5432
# Host of the database: localhost for local runs, `postgres` inside Docker,
# or your managed server name (e.g. myserver.postgres.database.azure.com).
POSTGRES_HOST=localhost
# Leave empty for local Docker; use `require` for managed cloud databases.
POSTGRES_SSLMODE=
# Optional: set by the orchestrator (e.g. Airflow run id) for idempotent re-runs.
# PIPELINE_BATCH_ID=
